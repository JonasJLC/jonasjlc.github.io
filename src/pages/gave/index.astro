---
import '../../styles/gave.css';

const title = 'En invitation til dig';
const description = 'En lille personlig invitation venter.';
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eae9e4" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://jonasjlc.github.io/gave/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jonasjlc.github.io/gave/" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <link rel="icon" href="/assets/avatar.svg" type="image/svg+xml" />
  </head>
  <body>
    <main id="gave-app">
      <section class="gave-shell" aria-labelledby="gave-title">
        <p class="gave-kicker">FORTROLIG</p>
        <h1 id="gave-title">En invitation til dig</h1>
        <p>Åbn invitationen i en browser med JavaScript slået til.</p>
      </section>
    </main>
    <noscript>
      <div class="gave-noscript">
        <p>Invitationen bliver bedst med JavaScript slået til. Prøv igen i en browser, hvor det er tilladt.</p>
      </div>
    </noscript>
    <script>
      import '../../scripts/gave';
    </script>
  </body>
</html>
